# Copy to .env and fill in real values. .env is gitignored — never commit
# real credentials here or anywhere else in the repo.

# MongoDB Atlas connection string (or local: mongodb://localhost:27017).
# Note: no "?replicaSet=rs0" needed for Atlas — the SRV record already
# resolves to the cluster's own replica set, and Atlas clusters are
# replica sets by default (required for the transactions used in
# execution_history writes).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=job_scheduler

HTTP_PORT=8080
METRICS_PORT=9100

SCHEDULER_TICK=500ms
CLAIM_TIMEOUT=5m
QUEUED_TIMEOUT=30s

# Required by cmd/scheduler and cmd/executor
KAFKA_BROKERS=localhost:9092

# Required by cmd/scheduler
ETCD_ENDPOINTS=localhost:2379

# Required by cmd/executor — which job type's dispatch topic this
# instance's consumer group joins
JOB_TYPE=noop
